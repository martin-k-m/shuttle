mode systems

# Loading a published model and answering with it, three ways.
#
# There is no server here and there cannot be. twill has no sockets and no
# process interface, so nothing can listen. This is the library a server would
# be built on, driven by a program instead of by a socket, and the README says
# so at the top rather than leaving it to be discovered.
#
#   twill run examples/serve.tw
#
# The working directory does not matter: twill resolves an import and a relative
# path argument against the directory of the file that contains it, so
# everything below is read from and written to examples/.
#
# It runs standalone. The three request files it reads are generated on first
# use, under a fixed seed, rather than checked in, because CI's source gate
# refuses any file in this repository that is not twill or documentation.
#
# The model is the one selvedge publishes. From checkouts of loom and selvedge
# beside this one:
#
#   cd ../loom     && twill run examples/classifier.tw
#   cp ../loom/examples/runs/blobs.params ../selvedge/examples/runs/blobs.params
#   cd ../selvedge && twill run examples/publish.tw
#   cp ../selvedge/examples/models/blobs-1.2.0.slv examples/models/blobs-1.2.0.slv
#
# Without that file this falls back to `md.from_params` over an untrained tree
# and a signature declared right here, which is the second of the two load paths
# src/model.tw documents and the weaker one: the signature becomes a claim
# instead of a fact. That is the point of showing both.

import "../src/model.tw" as md
import "../src/signature.tw" as sg
import "../src/predict.tw" as pr
import "../src/batcher.tw" as bat
import "../src/warmup.tw" as wu
import "../src/quant.tw" as q
import "../src/score.tw" as sc

# The forward pass. Yours, not shuttle's. shuttle owns the signature check, the
# batching, the warmup and the counting, and nothing else.
fn forward(p: Tree, x: Tensor) -> Tensor {
  let h = relu(x @ transpose(p.w1) + p.b1)
  h @ transpose(p.w2) + p.b2
}

# ---- the fixtures ----------------------------------------------------------

let FEATURES = 4
let CLASSES = 3

fn blob_rows(per_class: I64, s: I64) -> Tensor {
  seed(s)
  let centres = [[2.0, 0.0, -1.0, 0.5], [-2.0, 1.0, 0.0, -0.5], [0.0, -2.0, 1.5, 0.0]]
  let xs: Arr[Tensor] = []
  let c = 0
  while c < CLASSES {
    push(xs, randn(per_class, FEATURES) * 0.8 + centres[c])
    c = c + 1
  }
  concat(xs, 0)
}

fn ensure_csv(path: Str, per_class: I64, s: I64) {
  if path_exists(path) {
    return unit
  }
  let x = blob_rows(per_class, s)
  let rows = shape(x)[0]
  let out = ""
  let i = 0
  while i < rows {
    let line = ""
    let j = 0
    while j < FEATURES {
      if j > 0 { line = line + "," }
      line = line + str(item(x[i][j]))
      j = j + 1
    }
    out = out + line + "
"
    i = i + 1
  }
  write_file(path, out)
}

mkdir_all("models")
ensure_csv("requests.csv", 4, 20260811)
ensure_csv("batch.csv", 64, 20260810)
ensure_csv("holdout.csv", 24, 20260809)

# ---- load ------------------------------------------------------------------
#
# From a selvedge archive, so the signature is what the model was published
# with rather than what this file believes. Integrity is verified before the
# weights are trusted: a serving process is the last place anyone will look at
# the file, and a corrupt payload that reaches a forward pass produces
# predictions rather than an error.
fn untrained_tree() -> Str {
  seed(20260807)
  save({
    w1: randn(16, FEATURES) * 0.1,
    b1: zeros(16),
    w2: randn(CLASSES, 16) * 0.1,
    b2: zeros(CLASSES),
  }, "models/untrained.params")
  "models/untrained.params"
}

fn load_model() -> md.Loaded {
  if path_exists("models/blobs-1.2.0.slv") {
    return md.from_archive("models/blobs-1.2.0.slv")
  }
  print("models/blobs-1.2.0.slv is absent, so this serves an untrained tree")
  print("through from_params. See the header of this file for the three")
  print("commands that produce the archive.")
  md.from_params(untrained_tree(),
    sg.signature([-1, FEATURES], [-1, CLASSES], "logits"), "blobs-untrained")
}

let loaded = load_model()
if len(loaded.err) > 0 {
  print("shuttle: " + loaded.err)
  exit(1)
}
let model = loaded.model
print(md.describe(model))

# ---- the batching trade ----------------------------------------------------
#
# Both numbers are required and neither has a default, because the right answer
# is different for a fraud check and for an overnight job and neither is
# knowable from inside a library.
#
#   max_batch 32   throughput. Up to 32 rows in one forward pass.
#   max_hold  4    latency. A queued request waits through at most 4 arrivals.
#
# max_hold counts arrivals and not milliseconds. twill has a clock; shuttle has
# no concurrency, which is the actual reason. That is a worse knob than a
# duration and it is the honest one; see the top of src/batcher.tw for what it
# means under thin traffic.
let cfg = bat.config(32, 4)
let cfg_err = bat.validate(cfg)
if len(cfg_err) > 0 {
  print("shuttle: " + cfg_err)
  exit(1)
}

# ---- warm up ---------------------------------------------------------------
#
# At the two batch sizes the service will actually run: 1 when traffic is thin,
# 32 when it is not. What this does and does not cover is written out at the top
# of src/warmup.tw, and it is a shorter list than warmup in other frameworks
# because twill has no JIT and no kernel selection to warm.
let w = wu.warm(model, wu.sizes_for(cfg.max_batch), forward)
print(wu.report(w))

# ---- one request -----------------------------------------------------------

let one = pr.predict(model, [1.2, 0.4, -0.8, 2.1], forward)
if len(one.err) > 0 {
  print("shuttle: " + one.err)
} else {
  # `[1, CLASSES]` and not `[1, 3]`: an array literal whose elements are all
  # numeric literals is a Tensor, and `reshape` wants the dimensions as an
  # Arr[I64]. One name in the list is enough to make it one.
  let one_row: Arr[I64] = [1, CLASSES]
  let probs = pr.probabilities(model, reshape(one.out, one_row))
  print("class " + str(item(argmax(one.out, 0))) + " with " + str(item(max(probs.idx))))
}

# A bad request gets twill's kind of message rather than a failure inside a
# matmul four calls deep.
let bad = pr.predict(model, [1.0, 2.0], forward)
print(bad.err)

# ---- many requests, batched ------------------------------------------------

let bt = bat.batcher(cfg)
let arrivals = read_csv("requests.csv")
let i = 0
while i < shape(arrivals)[0] {
  let err = bat.submit(bt, model, arrivals[i])
  if len(err) > 0 {
    print("refused: " + err)
  }
  if bat.ready(bt) {
    let batch = bat.run(bt, model, forward)
    if len(batch.err) > 0 {
      print("shuttle: " + batch.err)
    }
  }
  i = i + 1
}
# The last partial batch. The caller's job, because only the caller knows its
# input is exhausted, and forgetting it is how a batcher loses the tail of a
# file.
bat.flush(bt, model, forward)
print(bat.report(bt))

# ---- scoring a file --------------------------------------------------------
#
# Chunked, so peak memory is the chunk's activations rather than the file's.
# Progress is rows and a percentage, with no time estimate, because there is no
# clock to extrapolate from.
let scored = sc.score_csv(model, "batch.csv", 512,
  sc.progress(5000, "scoring", 0), forward)
if len(scored.err) > 0 {
  print("shuttle: " + scored.err)
} else {
  print("scored " + str(scored.rows) + " rows")
}

# ---- what quantisation would cost ------------------------------------------
#
# The numerics are real: `.to(bf16)` and `.to(int8)` round exactly the way the
# formats do, so the accuracy question is answered on your own held-out data
# rather than guessed from a table. The bytes drop for real once the packed
# buffer (twill NEEDS-111) and a narrow archive encoding land; until then a
# narrow tensor rounds correctly and still fills eight-byte slots, which is why
# the two size lines below take a `realised` flag and print both numbers.
let held_out = read_csv("holdout.csv")

# bf16 first: it keeps f32's range, so it is the safer default and the one to
# reach for unless you have measured that f16's finer step buys you something.
let as_bf16 = q.quantize(model, q.BF16, q.minmax())
print("bf16: " + q.report(q.compare(model, as_bf16.model, held_out, forward)))

let as_f16 = q.quantize(model, q.F16, q.minmax())
print("f16:  " + q.report(q.compare(model, as_f16.model, held_out, forward)))

# Percentile calibration, because one outlier weight in a tensor makes the step
# coarse for every other weight in it.
let as_int8 = q.quantize(model, q.Int8, q.percentile(0.999))
print("int8: " + q.report(q.compare(model, as_int8.model, held_out, forward)))

# Four tensors in this model. `realised: false` is the footprint today, true is
# what it becomes once the storage lands.
print("stored today:   " + str(q.stored_bytes(model, q.F64, 4, false)) + " bytes")
print("int8 realised:  " + str(q.stored_bytes(model, q.Int8, 4, true)) + " bytes")
