mode systems

# bytes_compat.tw: the single place shuttle touches the byte-level surface of
# the systems subset.
#
# Every function here is one line over a runtime primitive. That is the point.
# The subset's byte primitives are still being named upstream, and when one is
# renamed this file changes instead of five. It also makes the dependency
# legible: docs/needs.md points at this file and says exactly which runtime
# operations shuttle cannot be written without.
#
# twill's own `src/bytes.tw` is the same file for the same reason. shuttle
# cannot import it: twill resolves a non-`std/` import as a path relative to the
# importing file, so only `std/` modules are reachable from an installed
# package, and `src/bytes.tw` is not one. This is the third copy in the
# ecosystem and loom's `src/report.tw` argument applies unchanged: the fix is
# `std/bytes`, not a wider import rule. docs/needs.md entry 10.

fn new() -> Bytes = bytes_new()

fn push(dst: Bytes, c: I64) {
  bytes_push(dst, c)
}

fn push_text(dst: Bytes, s: Str) {
  let i: I64 = 0
  while i < len(s) {
    bytes_push(dst, s[i])
    i = i + 1
  }
}

fn to_str(dst: Bytes) -> Str = bytes_to_str(dst)

# Bytes [lo, hi) as a Str, clamped rather than trapping. A digest that walks a
# file computes its bounds from lengths in that file, so a corrupt length would
# otherwise abort the program at the point where the useful thing to do is
# report which file was corrupt.
fn slice(s: Str, lo: I64, hi: I64) -> Str {
  let a = lo
  let z = hi
  if a < 0 {
    a = 0
  }
  if z > len(s) {
    z = len(s)
  }
  if z <= a {
    return ""
  }
  let out = bytes_new()
  let i = a
  while i < z {
    bytes_push(out, s[i])
    i = i + 1
  }
  bytes_to_str(out)
}

# Lowercase hex for one byte. A digest is compared by eye and pasted into issue
# reports, so the case is fixed here rather than at each call site.
let HEX: Str = "0123456789abcdef"

fn push_hex_byte(dst: Bytes, v: I64) {
  bytes_push(dst, HEX[and(shr(v, 4), 15)])
  bytes_push(dst, HEX[and(v, 15)])
}

fn starts_with(s: Str, p: Str) -> Bool {
  if len(p) > len(s) {
    return false
  }
  let i: I64 = 0
  while i < len(p) {
    if s[i] != p[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn index_of(s: Str, needle: Str) -> I64 {
  if len(needle) == 0 {
    return 0
  }
  let i: I64 = 0
  while i + len(needle) <= len(s) {
    if starts_with(slice(s, i, len(s)), needle) {
      return i
    }
    i = i + 1
  }
  -1
}

fn join(parts: Arr[Str], sep: Str) -> Str {
  let out = bytes_new()
  let i: I64 = 0
  while i < len(parts) {
    if i > 0 {
      push_text(out, sep)
    }
    push_text(out, parts[i])
    i = i + 1
  }
  bytes_to_str(out)
}
